{
  "name": "dataislands",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "prepare": "svelte-kit sync",
    "ownership": "node src/ownership/build.ts",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test test/*.test.ts",
    "islands:preview": "vite src/islands/preview",
    "islands:build": "vite build src/islands/preview --outDir ../../../node_modules/.cache/islands-preview --emptyOutDir"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.0.0",
    "@types/three": "^0.187.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "three": "^0.187.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.5"
  },
  "packageManager": "bun@1.3.14",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#islands/*": "./src/islands/*"
  }
}
